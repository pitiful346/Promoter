rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile images
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public app uploads (events, organizations, venues, teasers)
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /organizations/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /venues/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /teasers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny for anything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}